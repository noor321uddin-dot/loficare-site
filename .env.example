# Copy to .env. Every variable is validated at boot (src/lib/env.ts).
SITE_URL=http://127.0.0.1:4321
DATABASE_PATH=./data/leads.db
# Outbound webhook for every lead (GoHighLevel inbound webhook URL works as is). Optional.
LEAD_WEBHOOK_URL=
# SMTP URL for lead emails, e.g. smtp://user:pass@host:587. Optional.
SMTP_URL=
LEAD_EMAIL_TO=
# Cloudflare Turnstile secret. Optional, off when empty.
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=
# Plausible-compatible analytics domain. Optional, no script loads when empty.
ANALYTICS_DOMAIN=
# Contact placeholders (section 16 of the build prompt).
CONTACT_PHONE=+8801000000000
CONTACT_WHATSAPP=8801000000000
