# Copy to .env. Every variable is validated at boot (src/lib/env.mjs); nothing here is required to run.
SITE_URL=http://127.0.0.1:4321
HOST=0.0.0.0
PORT=4321
DATABASE_PATH=./data/leads.db

# Every lead is POSTed here as flat JSON. A GoHighLevel inbound webhook URL works as is. Optional.
LEAD_WEBHOOK_URL=

# Email a copy of every lead. SMTP_URL like smtp://user:pass@host:587 (or smtps://... for 465). Optional.
SMTP_URL=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=

# Cloudflare Turnstile. Off when empty; the honeypot, minimum fill time and rate limit are always on.
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=

# Plausible-compatible analytics domain. No script loads when empty, and none before consent.
ANALYTICS_DOMAIN=

# Contact placeholders (docs/OPEN-ITEMS.md). Phone in E.164, WhatsApp digits only.
CONTACT_PHONE=+8801000000000
CONTACT_WHATSAPP=8801000000000

# Per-IP submissions per form per ten minutes.
RATE_LIMIT_PER_10MIN=10
