---
import Base from '../layouts/Base.astro';
---
<Base title="LofiCare, build in progress">
  <main class="band-ink" style="min-height:100dvh;display:grid;place-items:center;padding:24px;text-align:center">
    <div>
      <img src="/brand/loficare-mark.png" alt="LofiCare" width="120" height="120" style="margin:0 auto 16px" />
      <h1 style="font-size:28px;max-width:22ch;margin:0 auto 12px">Run your whole facility on one platform, built for Bangladesh.</h1>
      <p style="color:var(--fg-muted);max-width:44ch;margin:0 auto 20px">Build in progress. The section variants board is at <a href="/variants">/variants</a>.</p>
    </div>
  </main>
</Base>
