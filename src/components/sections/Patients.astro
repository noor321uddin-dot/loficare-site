---
import Icon from '../Icon.astro';
import { t, localePath, type Locale } from '../../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const pickMsg = (i: number) => t(locale, `patients.msg.${i}.${locale === 'bn' ? 'bn' : 'en'}`);
const thread: Array<{ who: 'them' | 'me'; text: string }> = [
  { who: 'them', text: pickMsg(1) },
  { who: 'me', text: t(locale, 'patients.msg.2') },
  { who: 'them', text: pickMsg(3) },
  { who: 'them', text: pickMsg(4) },
  { who: 'them', text: pickMsg(5) },
];
---
<section id="patients" class="section">
  <div class="container split">
    <div>
      <div class="section-head">
        <h2>{t(locale, 'patients.h2')}</h2>
        <p class="lede">{t(locale, 'patients.body')}</p>
      </div>
      <div class="section-cta">
        <a class="btn btn-secondary" href={localePath(locale, '/patients/how-it-works')} data-track="find_doctor_click" data-audience="patient">{t(locale, 'patients.cta')} <Icon name="arrow-right" size={18} /></a>
      </div>
    </div>
    <figure class="thread-wrap">
      <ol class="thread" aria-label={t(locale, 'patients.sample')}>
        {thread.map((m) => (
          <li class:list={['msg', m.who]}>
            {m.who === 'them' ? <span class="m-text">{m.text}</span> : <span class="num">{m.text}</span>}
          </li>
        ))}
      </ol>
      <figcaption class="sample">{t(locale, 'patients.sample')}</figcaption>
    </figure>
  </div>
</section>
<style>
  .split { display: grid; gap: 28px; }
  .thread-wrap { margin: 0; display: grid; gap: 10px; justify-items: start; width: 100%; max-width: 440px; }
  .thread { list-style: none; margin: 0; padding: 16px; display: grid; gap: 8px; width: 100%; box-sizing: border-box; background: var(--bg-alt); border: 1px solid var(--line); border-radius: var(--radius-tile); }
  .msg { padding: 10px 14px; border-radius: 16px; max-width: 82%; line-height: 1.45; font-size: 15px; }
  .msg.them { background: var(--card); border: 1px solid var(--line); justify-self: start; border-bottom-left-radius: 4px; }
  .msg.me { background: var(--ink-950); color: var(--aqua-200); justify-self: end; border-bottom-right-radius: 4px; font-weight: 700; letter-spacing: 0.04em; }
  :global(html[lang="bn"]) .msg { font-size: 16px; line-height: 1.55; }
  @media (min-width: 768px) { .split { grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; } .thread-wrap { justify-self: end; } }
</style>
