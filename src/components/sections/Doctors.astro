---
import QRCode from 'qrcode';
import { t, type Locale } from '../../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const link = 'loficare.app/dr-rahman'; /* placeholder booking link, see docs/OPEN-ITEMS.md */
const qr = await QRCode.toString('https://' + link, { type: 'svg', margin: 0, color: { dark: '#041A1A', light: '#00000000' } });
---
<section id="doctors" class="section section-alt">
  <div class="container split">
    <div>
      <div class="section-head">
        <h2>{t(locale, 'doctors.h2')}</h2>
        <p class="lede">{t(locale, 'doctors.body')}</p>
      </div>
      <form id="trial" class="trial card" action="/api/trial-start" method="post" novalidate
        data-contact="single" data-form-name="trial" data-status-id="trial-status"
        data-success={t(locale, 'trial.success')} data-sending={t(locale, 'form.sending')} data-error-server={t(locale, 'form.error.server')}>
        <h3>{t(locale, 'trial.h3')}</h3>
        <div class="field" data-field="contact">
          <label for="trial-contact">{t(locale, 'trial.label')}</label>
          <input id="trial-contact" name="contact" type="text" inputmode="email" autocomplete="on" required />
          <p class="help">{t(locale, 'trial.help')}</p>
          <p class="error" role="alert">{t(locale, 'trial.error')}</p>
        </div>
        <input class="hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <input type="hidden" name="ts" value="" />
        <input type="hidden" name="language" value={locale} />
        <button class="btn btn-primary" type="submit" data-track="trial_submit" data-audience="doctor">{t(locale, 'trial.submit')}</button>
      </form>
      <p id="trial-status" class="form-status" hidden tabindex="-1" aria-live="polite"></p>
    </div>
    <figure class="sign-wrap">
      <div class="sign">
        <span class="s-name" lang="bn">ডা. রহমান</span>
        <span class="s-spec">{t(locale, 'doctors.sign.spec')}</span>
        <span class="s-hours">{t(locale, 'doctors.sign.hours')}</span>
        <div class="s-link">
          <span class="url">{link}</span>
          <span class="qr" set:html={qr} />
        </div>
        <span class="s-scan">{t(locale, 'doctors.sign.scan')}</span>
      </div>
      <figcaption class="sample">{t(locale, 'doctors.sign.sample')}</figcaption>
    </figure>
  </div>
</section>
<style>
  .split { display: grid; gap: 32px; }
  .trial { margin-top: 24px; padding: 20px; display: grid; gap: 14px; max-width: 460px; }
  .trial h3 { font-size: 18px; }
  .trial .btn { justify-self: start; }
  .sign-wrap { margin: 0; display: grid; gap: 10px; justify-items: start; }
  .sign { width: min(100%, 420px); display: grid; gap: 6px; padding: 24px; border-radius: 14px; background: var(--ink-950); color: #F2FBFA; border: 1px solid var(--ink-800); box-shadow: inset 0 0 40px rgba(64, 232, 224, 0.18), 0 12px 32px rgba(4, 26, 26, 0.18); }
  .s-name { font-size: 34px; font-weight: 800; line-height: 1.35; }
  .s-spec { color: var(--mist-on-ink); }
  .s-hours { color: var(--mist-on-ink); font-size: 14px; }
  .s-link { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; margin-top: 14px; }
  .url { font-weight: 800; font-size: 20px; color: var(--aqua-400); word-break: break-all; }
  .qr { display: block; width: 84px; height: 84px; flex: none; background: #FFFFFF; padding: 6px; border-radius: 8px; }
  .qr :global(svg) { width: 100%; height: 100%; display: block; }
  .s-scan { font-size: 13px; color: var(--mist-on-ink); text-align: right; }
  @media (min-width: 768px) { .split { grid-template-columns: 1.1fr 0.9fr; gap: 48px; align-items: center; } .sign-wrap { justify-items: center; } }
</style>
<script>
  import { enhanceForm } from '../../lib/forms';
  const f = document.getElementById('trial') as HTMLFormElement | null;
  if (f) enhanceForm(f);
</script>
