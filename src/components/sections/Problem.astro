---
import { t, type Locale } from '../../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const strands = ['M0 20C150 20 200 80 300 80', 'M0 50C150 50 200 80 300 80', 'M0 80H300', 'M0 110C150 110 200 80 300 80', 'M0 140C150 140 200 80 300 80'];
---
<section id="problem" class="section">
  <div class="container">
    <div class="section-head"><h2>{t(locale, 'problem.h2')}</h2></div>
    <div class="cols">
      <div class="col">
        <h3>{t(locale, 'problem.facility.h3')}</h3>
        <ul>{[1, 2, 3, 4, 5, 6].map((i) => <li>{t(locale, `problem.facility.${i}`)}</li>)}</ul>
      </div>
      <div class="col">
        <h3>{t(locale, 'problem.chamber.h3')}</h3>
        <ul>{[1, 2, 3].map((i) => <li>{t(locale, `problem.chamber.${i}`)}</li>)}</ul>
      </div>
    </div>
    <figure class="join">
      <svg class="join-svg" viewBox="0 0 600 160" aria-hidden="true" focusable="false">
        {strands.map((d) => <path class="strand" d={d} />)}
        <path class="main" d="M300 80H520" />
        <path class="plus" d="M556 60h8v12h12v8h-12v12h-8V80h-12v-8h12z" />
      </svg>
      <figcaption>{t(locale, 'problem.join')}</figcaption>
    </figure>
  </div>
</section>
<style>
  .cols { display: grid; gap: 28px; margin-top: 28px; }
  .col h3 { margin-bottom: 10px; }
  .col ul { margin: 0; padding: 0; list-style: none; color: var(--fg-muted); display: grid; gap: 8px; }
  .col li { padding-left: 16px; position: relative; }
  .col li::before { content: ''; position: absolute; left: 0; top: 0.7em; width: 6px; height: 2px; background: var(--accent-strong); }
  .join { margin: 36px 0 0; display: grid; gap: 12px; }
  .join-svg { width: min(100%, 600px); height: auto; overflow: visible; }
  .strand, .main { fill: none; stroke: var(--accent-strong); stroke-width: 3; stroke-linecap: round; }
  .strand { opacity: 0.7; }
  .plus { fill: var(--aqua-400); stroke: var(--accent-strong); stroke-width: 2; }
  figcaption { font-weight: 700; max-width: 40ch; }
  @media (min-width: 768px) {
    .cols { grid-template-columns: 1fr 1fr; gap: 48px; }
    .join { grid-template-columns: 1fr 1fr; align-items: center; gap: 48px; margin-top: 48px; }
    figcaption { font-size: 20px; line-height: 1.35; }
  }
</style>
<script>
  /* The line drawing loads GSAP only when the figure comes within a screen of the viewport, so the library
     never competes with the hero's first paint. Until then the strokes are hidden by their dash offset. */
  const fig = document.querySelector<HTMLElement>('#problem .join');
  const paths = fig ? Array.from(fig.querySelectorAll<SVGPathElement>('path.strand, path.main')) : [];
  const plus = fig?.querySelector<SVGPathElement>('path.plus');
  if (fig && paths.length && plus && !matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    for (const p of paths) { const len = p.getTotalLength(); p.style.strokeDasharray = `${len}`; p.style.strokeDashoffset = `${len}`; }
    plus.style.opacity = '0';
    const reveal = () => { for (const p of paths) p.style.strokeDashoffset = '0'; plus.style.opacity = '1'; };
    const io = new IntersectionObserver(async (entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      io.disconnect();
      try {
        const [{ gsap }, { ScrollTrigger }] = await Promise.all([import('gsap'), import('gsap/ScrollTrigger')]);
        gsap.registerPlugin(ScrollTrigger);
        gsap.timeline({ scrollTrigger: { trigger: fig, start: 'top 85%', end: 'bottom 50%', scrub: 0.5 } })
          .to(paths, { strokeDashoffset: 0, ease: 'none', stagger: 0.06 })
          .fromTo(plus, { opacity: 0, scale: 0.6, transformOrigin: '50% 50%' }, { opacity: 1, scale: 1, ease: 'expo.out', duration: 0.3 }, '-=0.1');
        ScrollTrigger.refresh();
      } catch { reveal(); }
    }, { rootMargin: '0px 0px 30% 0px' });
    io.observe(fig);
  }
</script>
