---
import Icon from '../Icon.astro';
import { t, type Locale } from '../../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const states = ['pick', 'done', 'code', 'done'];
---
<section id="appointments" class="section">
  <div class="container">
    <div class="section-head"><h2>{t(locale, 'appointments.h2')}</h2></div>
    <div class="layout">
      <ol class="benefits">
        {[1, 2, 3, 4].map((i) => (
          <li class="benefit" data-state={states[i - 1]}>
            <h3>{t(locale, `appointments.b${i}.h3`)}</h3>
            <p class="muted">{t(locale, `appointments.b${i}.p`)}</p>
          </li>
        ))}
      </ol>
      <div class="widget-col">
        <div class="widget card" data-state="pick" id="booking-widget">
          <div class="w-head"><strong>{t(locale, 'widget.title')}</strong><span class="muted">{t(locale, 'widget.spec')}</span></div>
          <div class="w-step w-pick">
            <p class="w-label">{t(locale, 'widget.pick')}</p>
            <div class="slots" role="group" aria-label={t(locale, 'widget.pick')}>
              <button type="button" class="slot" aria-pressed="true">Sun 10:40</button>
              <button type="button" class="slot" aria-pressed="false">Sun 11:00</button>
              <button type="button" class="slot" aria-pressed="false">Sun 11:20</button>
            </div>
            <label class="w-label" for="w-phone">{t(locale, 'widget.phone')}</label>
            <input id="w-phone" type="tel" value="01712 345678" readonly />
            <button type="button" class="btn btn-primary w-next" data-to="code">{t(locale, 'widget.confirm')}</button>
          </div>
          <div class="w-step w-code">
            <label class="w-label" for="w-code">{t(locale, 'widget.code')}</label>
            <input id="w-code" inputmode="numeric" value="4471" readonly />
            <button type="button" class="btn btn-primary w-next" data-to="done">{t(locale, 'widget.verify')}</button>
          </div>
          <div class="w-step w-done">
            <p class="w-ok"><Icon name="check" size={18} /> {t(locale, 'widget.done')}</p>
            <div class="board">
              <div class="b-row">
                <div><span class="label">{t(locale, 'widget.board.now')}</span><div class="big">9</div></div>
                <div><span class="label">{t(locale, 'widget.board.yours')}</span><div class="big yours">12</div></div>
              </div>
              <p class="label">Sun 10:40, Room 3</p>
            </div>
            <button type="button" class="btn btn-quiet w-next" data-to="pick">{t(locale, 'widget.again')}</button>
          </div>
        </div>
        <p class="sample">{t(locale, 'appointments.demo')}</p>
      </div>
    </div>
    <div class="section-cta"><a class="btn btn-primary" href="#trial" data-track="section_cta_click" data-audience="doctor">{t(locale, 'appointments.cta')}</a></div>
  </div>
</section>
<style>
  .layout { display: grid; gap: 24px; margin-top: 24px; }
  .benefits { list-style: none; margin: 0; padding: 0; display: grid; gap: 22px; }
  .benefit h3 { margin-bottom: 4px; }
  .widget-col { display: grid; gap: 8px; order: -1; }
  .widget { padding: 18px; display: grid; gap: 12px; max-width: 380px; }
  .w-head { display: grid; gap: 2px; padding-bottom: 12px; border-bottom: 1px solid var(--line); }
  .w-step { display: none; gap: 10px; }
  .widget[data-state="pick"] .w-pick, .widget[data-state="code"] .w-code, .widget[data-state="done"] .w-done { display: grid; }
  .w-label { font-weight: 700; font-size: 14px; }
  .slots { display: flex; gap: 8px; flex-wrap: wrap; }
  .slot { border: 1.5px solid var(--line); background: var(--card); color: var(--fg); border-radius: 999px; padding: 8px 14px; min-height: 44px; font-weight: 600; cursor: pointer; }
  .slot[aria-pressed="true"] { border-color: var(--accent-strong); background: var(--bg-alt); color: var(--accent); }
  .widget input { min-height: 48px; border: 1.5px solid var(--line); border-radius: var(--radius-control); padding: 10px 14px; background: var(--bg); color: var(--fg); font-variant-numeric: tabular-nums; }
  .w-ok { display: inline-flex; align-items: center; gap: 6px; color: var(--ok); font-weight: 800; }
  .b-row { display: flex; gap: 28px; margin-bottom: 8px; }
  .big.yours { color: var(--aqua-200); }
  @media (min-width: 768px) {
    .layout { grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; margin-top: 32px; }
    .widget-col { order: 0; position: sticky; top: 96px; justify-items: start; }
    .benefits { gap: 0; padding-block: 3vh 5vh; }
    .benefit { min-height: 28vh; display: flex; flex-direction: column; justify-content: center; }
  }
</style>
<script>
  const widget = document.getElementById('booking-widget');
  if (widget) {
    widget.addEventListener('click', (e) => {
      const next = (e.target as HTMLElement).closest<HTMLElement>('.w-next');
      if (next) { widget.dataset.state = next.dataset.to; return; }
      const slot = (e.target as HTMLElement).closest<HTMLButtonElement>('.slot');
      if (slot) widget.querySelectorAll('.slot').forEach((s) => s.setAttribute('aria-pressed', String(s === slot)));
    });
    if (matchMedia('(min-width: 768px)').matches && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        for (const en of entries) if (en.isIntersecting) widget.dataset.state = (en.target as HTMLElement).dataset.state;
      }, { threshold: 0.6 });
      document.querySelectorAll('#appointments .benefit').forEach((b) => io.observe(b));
    }
  }
</script>
