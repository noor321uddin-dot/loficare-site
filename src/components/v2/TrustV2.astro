---
import Icon from '../Icon.astro';
import { t, type Locale } from '../../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
/* v2 trust: three plain facts in a row under one headline. No cards, no mock audit screen. */
const facts = [
  { icon: 'map-pin', i: 1 },
  { icon: 'lock-key', i: 2 },
  { icon: 'user-list', i: 3 },
];
---
<section id="data" class="section">
  <div class="container">
    <h2>{t(locale, 'trust2.h2')}</h2>
    <dl class="facts">
      {facts.map((f) => (
        <div class="fact">
          <dt><Icon name={f.icon} size={22} />{t(locale, `trust2.f${f.i}.h`)}</dt>
          <dd>{t(locale, `trust2.f${f.i}.p`)}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
<style>
  h2 { font-size: clamp(28px, 3.2vw, 40px); letter-spacing: -0.03em; line-height: 1.1; max-width: 20ch; }
  .facts { display: grid; gap: 28px; margin: 32px 0 0; }
  .fact { display: grid; gap: 8px; padding-top: 18px; border-top: 2px solid var(--orbit-600); }
  dt { display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 18px; }
  dt :global(.icon) { color: var(--orbit-600); }
  dd { margin: 0; color: var(--fg-muted); max-width: 36ch; }
  @media (min-width: 768px) { .facts { grid-template-columns: repeat(3, 1fr); gap: 40px; } }
</style>
