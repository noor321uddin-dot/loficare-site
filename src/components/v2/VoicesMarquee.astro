---
import { voices, pick } from '../../content/voices';
import { t, type Locale } from '../../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
/* v2 testimonials: the page's one marquee and its one tinted band. Two rows, opposite directions, pause on hover
   or focus; under reduced motion the rows stop and wrap. Entries flagged `sample` are layout stand-ins and the
   band says so; replace them in src/content/voices.ts. Same pattern as the 21st.dev testimonial marquee, in CSS. */
const hasSample = voices.some((v) => v.sample);
const half = Math.ceil(voices.length / 2);
const rows = [voices.slice(0, half), voices.slice(half)];
const initial = (s: string) => s.replace(/^(Dr\.?|ডা\.?)\s*/, '').charAt(0);
---
{voices.length > 0 && (
  <section id="voices" class="section band">
    <div class="container head">
      <h2>{t(locale, 'voices.h2')}</h2>
      {hasSample && <p class="sample">{t(locale, 'voices.sample')}</p>}
    </div>
    <div class="marquee" role="region" aria-label={t(locale, 'voices.h2')} tabindex="0">
      {rows.map((row, r) => (
        <div class:list={['track', r === 1 && 'reverse']}>
          {[0, 1].map((copy) => (
            <ul class="group" aria-hidden={copy === 1 ? 'true' : undefined}>
              {row.map((v) => (
                <li class="card">
                  <blockquote><p>{pick(v.quote, locale)}</p></blockquote>
                  <div class="who">
                    <span class="av">{v.photo ? <img src={v.photo} alt="" width="40" height="40" loading="lazy" /> : initial(pick(v.name, locale))}</span>
                    <span class="meta"><strong>{pick(v.name, locale)}</strong><span>{pick(v.role, locale)}, {pick(v.place, locale)}</span></span>
                  </div>
                </li>
              ))}
            </ul>
          ))}
        </div>
      ))}
      <span class="fade l" aria-hidden="true"></span><span class="fade r" aria-hidden="true"></span>
    </div>
  </section>
)}
<style>
  .band { background: var(--bg-alt); }

  .head { display: grid; gap: 10px; margin-bottom: 28px; }
  h2 { font-size: clamp(28px, 3.2vw, 40px); letter-spacing: -0.03em; line-height: 1.1; }
  .marquee { position: relative; display: grid; gap: 14px; overflow: hidden; outline: none; }
  .marquee:focus-visible { outline: 2px solid var(--orbit-600); outline-offset: 4px; }
  .track { display: flex; width: max-content; animation: slide 46s linear infinite; }
  .track.reverse { animation-direction: reverse; animation-duration: 52s; }
  .marquee:hover .track, .marquee:focus-within .track { animation-play-state: paused; }
  .group { display: flex; gap: 14px; padding: 0 7px; margin: 0; list-style: none; }
  .card { width: 390px; flex: none; background: var(--card); border: 1px solid var(--line); border-radius: 18px; padding: 18px 20px; display: grid; gap: 14px; align-content: space-between; }
  blockquote { margin: 0; }
  blockquote p { margin: 0; font-size: 16px; line-height: 1.5; color: var(--fg); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .who { display: flex; align-items: center; gap: 10px; }
  .av { width: 40px; height: 40px; border-radius: 50%; overflow: hidden; flex: none; display: grid; place-items: center; background: #DCE6FB; color: var(--orbit-700); font-weight: 800; }
  .av img { width: 100%; height: 100%; object-fit: cover; }
  .meta { display: grid; font-size: 14px; line-height: 1.3; }
  .meta span { color: var(--fg-muted); }
  .fade { position: absolute; inset-block: 0; width: 12%; pointer-events: none; }
  .fade.l { left: 0; background: linear-gradient(to right, var(--bg-alt), transparent); }
  .fade.r { right: 0; background: linear-gradient(to left, var(--bg-alt), transparent); }


  @keyframes slide { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .track { animation: none; width: auto; }
    .group { flex-wrap: wrap; justify-content: center; }
    .group[aria-hidden="true"] { display: none; }
    .card { width: min(340px, 100%); }
    .fade { display: none; }
  }
</style>
