---
import Mark from './Mark.astro';
import LangToggle from './LangToggle.astro';
import ThemeToggle from './ThemeToggle.astro';
import Icon from './Icon.astro';
import { t, localePath, type Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const phone = (import.meta.env.CONTACT_PHONE as string | undefined) ?? '+8801000000000';
const wa = (import.meta.env.CONTACT_WHATSAPP as string | undefined) ?? '8801000000000';
/* Two even rows: the brand and the two toggles share the first, the four links share the second on one baseline. */
---
<footer class="site-footer">
  <div class="container">
    <div class="row top">
      <div class="brand">
        <Mark size={36} />
        <p class="muted">{t(locale, 'footer.company')}</p>
      </div>
      <div class="controls">
        <LangToggle locale={locale} nav={false} />
        <ThemeToggle toDark={t(locale, 'theme.toDark')} toLight={t(locale, 'theme.toLight')} />
      </div>
    </div>
    <nav class="row links" aria-label={t(locale, 'footer.contact')}>
      <a href={`https://wa.me/${wa}`} rel="noopener" data-track="whatsapp_click" data-placeholder="contact"><Icon name="whatsapp-logo" size={18} /> {t(locale, 'footer.whatsapp')}</a>
      <a href={`tel:${phone}`} data-track="phone_click" data-placeholder="contact"><Icon name="phone" size={18} /> {t(locale, 'footer.call')} <span class="num">{phone}</span></a>
      <a href={localePath(locale, '/privacy')}>{t(locale, 'footer.privacy')}</a>
      <a href={localePath(locale, '/terms')}>{t(locale, 'footer.terms')}</a>
    </nav>
  </div>
</footer>
<style>
  .site-footer { border-top: 1px solid var(--line); padding-block: 32px 40px; }
  .row { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; }
  .top { justify-content: space-between; padding-bottom: 24px; border-bottom: 1px solid var(--line); }
  .brand { display: flex; align-items: center; gap: 12px; }
  .brand p { margin: 0; font-size: 15px; }
  .controls { display: flex; gap: 8px; align-items: center; }
  .links { padding-top: 24px; gap: 14px 32px; }
  .links a { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; color: var(--fg); text-decoration: none; font-weight: 600; }
  .links a:hover { color: var(--accent); }
  .links :global(.icon) { color: var(--accent); }
  .num { font-variant-numeric: tabular-nums; }
  @media (min-width: 768px) { .site-footer { padding-block: 40px 48px; } .links a { min-height: 0; } }
</style>
