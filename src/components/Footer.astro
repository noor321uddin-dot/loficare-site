---
import Mark from './Mark.astro';
import LangToggle from './LangToggle.astro';
import ThemeToggle from './ThemeToggle.astro';
import Icon from './Icon.astro';
import { t, localePath, type Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const phone = (import.meta.env.CONTACT_PHONE as string | undefined) ?? '+8801000000000';
const wa = (import.meta.env.CONTACT_WHATSAPP as string | undefined) ?? '8801000000000';
---
<footer class="site-footer">
  <div class="container grid">
    <div class="brand">
      <Mark size={40} />
      <p class="muted">{t(locale, 'footer.company')}</p>
    </div>
    <nav class="links" aria-label={t(locale, 'footer.contact')}>
      <a href={`https://wa.me/${wa}`} rel="noopener" data-track="whatsapp_click" data-placeholder="contact"><Icon name="whatsapp-logo" size={18} /> {t(locale, 'footer.whatsapp')}</a>
      <a href={`tel:${phone}`} data-track="phone_click" data-placeholder="contact"><Icon name="phone" size={18} /> {t(locale, 'footer.call')} <span class="num">{phone}</span></a>
      <a href={localePath(locale, '/privacy')}>{t(locale, 'footer.privacy')}</a>
      <a href={localePath(locale, '/terms')}>{t(locale, 'footer.terms')}</a>
    </nav>
    <div class="controls">
      <LangToggle locale={locale} />
      <ThemeToggle toDark={t(locale, 'theme.toDark')} toLight={t(locale, 'theme.toLight')} />
    </div>
  </div>
</footer>
<style>
  .site-footer { border-top: 1px solid var(--line); padding-block: 40px; margin-top: 40px; }
  .grid { display: grid; gap: 24px; }
  .brand { display: grid; gap: 10px; }
  .links { display: flex; flex-wrap: wrap; gap: 14px 22px; }
  .links a { display: inline-flex; align-items: center; gap: 6px; color: var(--fg); text-decoration: none; font-weight: 600; }
  .links a:hover { color: var(--accent); }
  .controls { display: flex; gap: 8px; align-items: center; }
  @media (min-width: 768px) { .grid { grid-template-columns: 1.2fr 2fr auto; align-items: center; } }
</style>
