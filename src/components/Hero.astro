---
import HeroGlobe from './HeroGlobe.astro';
import { t, type Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
/* The first viewport: the facility claim and two actions on the left; on the right, a small world you drag while a
   doctor runs to stay on top of it (HeroGlobe). The orbit and queue board components are kept for reuse. */
---
<section id="hero" class="hero">
  <div class="container grid">
    <div class="copy">
      <h1>{t(locale, 'hero.h1')}</h1>
      <p class="lede">{t(locale, 'hero.sub')}</p>
      <div class="actions">
        <a class="btn btn-primary" href="#demo" data-track="hero_cta_click" data-audience="facility">{t(locale, 'hero.cta1')}</a>
        <a class="btn btn-secondary" href="#appointments" data-track="hero_cta_click" data-audience="doctor">{t(locale, 'hero.cta2')}</a>
      </div>
    </div>
    <div class="visual">
      <HeroGlobe locale={locale} class="hero-board" />
    </div>
  </div>
</section>
<style>
  .hero { padding-block: 28px 32px; background: radial-gradient(ellipse at 6% 15%, #FFFEFA 0%, #FBFCFF 38%, #F0F6FF 100%); }
  :global(html[data-theme="dark"]) .hero { background: radial-gradient(ellipse at 6% 15%, #0E2230 0%, #081A22 50%, #0B1E2E 100%); }
  .grid { display: grid; gap: 32px; width: 100%; }
  h1 { font-size: clamp(32px, 3.4vw, 40px); line-height: 1.08; max-width: 32ch; }
  :global(html:lang(bn)) h1 { line-height: 1.3; }
  .lede { margin-top: 14px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
  .visual { display: grid; }
  .visual :global(.hero-board) { width: 100%; }
  @media (min-width: 768px) {
    .hero { min-height: min(calc(100dvh - 68px), 720px); display: flex; align-items: center; padding-block: 40px 56px; }
    .grid { grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
    .visual { justify-items: center; }
    .visual :global(.hero-board) { max-width: 600px; }
  }
</style>
