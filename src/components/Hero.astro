---
import { t, type Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;

/* The mark's geometry in a 1000-unit box (see docs/DECISIONS.md and public/brand/loficare-mark.svg).
   Thirteen tiles sit on the ring's centreline, four make the L, the cross is the appointment module. */
const CX = 501, CY = 499, R = 187.5, A1 = 188, SPAN = 276, N = 13, S = 66;
const modules = [
  'Facility, people and access control',
  'Patient identity and registry',
  'Doctor, referrer and earnings',
  'Service catalogue and pricing',
  'Visit and order desk',
  'Billing, payments and counter',
  'Credit accounts: corporate, insurance, health card',
  'Sample, collection, barcode and QR',
  'Result entry, verification and quality control',
  'Imaging and radiology',
  'Report release, delivery and archive',
  'Clinical records, prescription and digital forms',
  'Inpatient: admission, ward, OT, emergency and ancillary',
  'Pharmacy and inventory',
  'Workforce, assets and compliance',
  'Communication, patient portal and service desk',
  'Reporting, analytics and MIS',
];
type Tile = { x: number; y: number; rot: number; name: string; sx: number; sy: number; srot: number; sscale: number };
const scatter = (i: number) => ({
  sx: Math.round(Math.cos(i * 2.399) * (330 + (i % 3) * 80)),
  sy: Math.round(Math.sin(i * 1.731) * (300 + (i % 4) * 60)),
  srot: ((i * 53) % 360) - 180,
  sscale: Math.round((0.7 + (i % 3) * 0.12) * 100) / 100,
});
const tiles: Tile[] = [];
for (let i = 0; i < N; i++) {
  const deg = A1 + (i + 0.5) * (SPAN / N);
  const rad = (deg * Math.PI) / 180;
  tiles.push({ x: CX + R * Math.cos(rad), y: CY + R * Math.sin(rad), rot: deg + 90, name: modules[i], ...scatter(i) });
}
const lTiles: Array<[number, number]> = [[311.5, 540.5], [311.5, 612.5], [311.5, 684.5], [393, 684.5]];
lTiles.forEach(([x, y], k) => tiles.push({ x, y, rot: 0, name: modules[N + k], ...scatter(N + k) }));
const r = (n: number) => Math.round(n * 10) / 10;
---
<section id="hero" class="hero">
  <div class="container grid">
    <div class="copy">
      <h1>{t(locale, 'hero.h1')}</h1>
      <p class="lede">{t(locale, 'hero.sub')}</p>
      <div class="actions">
        <a class="btn btn-primary" href="#demo" data-track="hero_cta_click" data-audience="facility">{t(locale, 'hero.cta1')}</a>
        <a class="btn btn-secondary" href="#appointments" data-track="hero_cta_click" data-audience="doctor">{t(locale, 'hero.cta2')}</a>
      </div>
    </div>
    <div class="visual">
      <svg class="assembly" viewBox="0 0 1000 1000" role="img" aria-labelledby="assembly-title">
        <title id="assembly-title">{t(locale, 'hero.assembly.alt')}</title>
        <defs>
          <linearGradient id="hero-cross" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#40E8E0" /><stop offset="1" stop-color="#A7FCF6" /></linearGradient>
        </defs>
        {tiles.map((tile) => (
          <g class="tile" data-sx={tile.sx} data-sy={tile.sy} data-srot={tile.srot} data-sscale={tile.sscale}>
            <title>{tile.name}. {t(locale, 'hero.early')}</title>
            <rect x={r(tile.x - S / 2)} y={r(tile.y - S / 2)} width={S} height={S} rx="12" transform={`rotate(${r(tile.rot)} ${r(tile.x)} ${r(tile.y)})`} />
          </g>
        ))}
        <g class="tile tile-cross" data-sx="40" data-sy="-320" data-srot="-28" data-sscale="0.85">
          <title>{t(locale, 'hero.available')}</title>
          <path d="M456 406h82v58h58v82h-58v58h-82v-58h-58v-82h58z" />
        </g>
      </svg>
    </div>
  </div>
</section>
<style>
  .hero { padding-block: 28px 32px; }
  .grid { display: grid; gap: 28px; width: 100%; }
  h1 { font-size: clamp(32px, 3.4vw, 40px); line-height: 1.08; max-width: 32ch; }
  :global(html:lang(bn)) h1 { line-height: 1.3; }
  .lede { margin-top: 14px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
  .visual { display: grid; place-items: center; }
  .assembly { width: min(100%, 380px); height: auto; overflow: visible; }
  .tile rect { fill: var(--tile); stroke: var(--tile-line); stroke-width: 3; }
  .tile-cross path { fill: url(#hero-cross); stroke: var(--tile-line); stroke-width: 3; }
  :global(html[data-theme="dark"]) .tile-cross path { stroke: none; filter: drop-shadow(0 0 18px rgba(64, 232, 224, 0.45)); }
  @media (min-width: 768px) {
    .hero { min-height: calc(100dvh - 68px); display: flex; align-items: center; padding-block: 48px 64px; }
    .grid { grid-template-columns: 1.25fr 0.75fr; gap: 48px; align-items: center; }
    .assembly { width: min(100%, 520px); }
  }
</style>
<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const root = document.documentElement;
  const hero = document.getElementById('hero');
  const svg = hero?.querySelector<SVGSVGElement>('.assembly');

  if (hero && svg && root.getAttribute('data-assemble') === 'pending') {
    gsap.registerPlugin(ScrollTrigger);
    const tiles = Array.from(svg.querySelectorAll<SVGGElement>('.tile'));
    const num = (el: Element, k: string) => Number((el as SVGGElement).dataset[k] ?? 0);
    gsap.set(tiles, {
      x: (_i: number, el: Element) => num(el, 'sx'),
      y: (_i: number, el: Element) => num(el, 'sy'),
      rotation: (_i: number, el: Element) => num(el, 'srot'),
      scale: (_i: number, el: Element) => num(el, 'sscale'),
      opacity: 0.35,
      transformOrigin: '50% 50%',
    });
    root.removeAttribute('data-assemble');
    const finish = () => { try { sessionStorage.setItem('lc-assembled', '1'); } catch {} };
    const tl = gsap.timeline({ paused: true, defaults: { ease: 'expo.out' }, onComplete: finish });
    tl.to(tiles, { x: 0, y: 0, rotation: 0, scale: 1, opacity: 1, duration: 1.5, stagger: { each: 0.045, from: 'random' } });

    if (import.meta.env.DEV) (window as any).__lc = { gsap, tl, ScrollTrigger };
    if (matchMedia('(min-width: 768px)').matches) {
      const st = ScrollTrigger.create({ trigger: hero, start: 'top top', end: '+=70%', scrub: 0.6, animation: tl });
      // kill(revert, allowAnimation): without the second flag ScrollTrigger kills the timeline too
      window.setTimeout(() => { if (tl.progress() < 0.05) { st.kill(false, true); tl.play(); } }, 2200);
    } else {
      ScrollTrigger.create({ trigger: svg, start: 'top 85%', once: true, onEnter: () => tl.play() });
    }
  }
</script>
