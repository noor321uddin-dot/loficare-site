---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { t, localePath, type Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<Base title={`${t(locale, 'how.title')}, LofiCare`} description={t(locale, 'how.body')} locale={locale} path="/patients/how-it-works">
  <Header locale={locale} />
  <main id="main" class="section">
    <div class="container narrow">
      <h1>{t(locale, 'how.title')}</h1>
      <p class="lede">{t(locale, 'how.body')}</p>
      <ol class="steps">
        {[1, 2, 3, 4].map((i) => (
          <li>
            <span class="num n">{i}</span>
            <div>
              <p class="step-bn" lang="bn">{t('bn', `how.step.${i}`)}</p>
              <p class="step-en muted" lang="en">{t('en', `how.step.${i}`)}</p>
            </div>
          </li>
        ))}
      </ol>
      <a class="btn btn-secondary" href={localePath(locale, '/') + '#patients'}>{t(locale, 'how.back')}</a>
    </div>
  </main>
  <Footer locale={locale} />
</Base>
<style>
  .narrow { max-width: 720px; }
  h1 { font-size: clamp(28px, 4vw, 40px); }
  .lede { margin-top: 14px; }
  .steps { list-style: none; margin: 28px 0; padding: 0; display: grid; gap: 14px; }
  .steps li { display: grid; grid-template-columns: 40px 1fr; gap: 14px; align-items: start; padding: 14px 0; border-top: 1px solid var(--line); }
  .n { width: 40px; height: 40px; border-radius: 999px; display: grid; place-items: center; background: var(--ink-950); color: var(--aqua-200); }
  .step-bn { font-weight: 700; font-size: 18px; line-height: 1.5; }
</style>
