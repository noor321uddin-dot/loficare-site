---
import Mark from './Mark.astro';
import LangToggle from './LangToggle.astro';
import ThemeToggle from './ThemeToggle.astro';
import { t, localePath, type Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<header class="site-header">
  <div class="container bar">
    <a class="brand" href={localePath(locale, '/')} aria-label={t(locale, 'a11y.home')}>
      <Mark size={36} />
      <span class="wordmark">LofiCare</span>
    </a>
    <nav class="quiet" aria-label={t(locale, 'a11y.sections')}>
      <a class="link-quiet" href="#doctors">{t(locale, 'nav.doctors')}</a>
      <a class="link-quiet" href={localePath(locale, "/patients/how-it-works")}>{t(locale, 'nav.patients')}</a>
    </nav>
    <div class="actions">
      <LangToggle locale={locale} />
      <ThemeToggle toDark={t(locale, 'theme.toDark')} toLight={t(locale, 'theme.toLight')} />
      <a class="btn btn-primary demo" href="#demo" data-track="nav_demo_click">{t(locale, 'nav.demo')}</a>
    </div>
  </div>
</header>
<style>
  .site-header { position: sticky; top: 0; z-index: var(--z-header); background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .bar { height: 68px; display: flex; align-items: center; gap: 16px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; color: var(--fg); }
  .wordmark { font-weight: 800; font-size: 20px; letter-spacing: -0.02em; }
  .quiet { display: none; gap: 20px; margin-left: 12px; }
  .actions { margin-left: auto; display: flex; align-items: center; gap: 8px; }
  .demo { display: none; }
  @media (min-width: 480px) { .demo { display: inline-flex; } }
  @media (min-width: 900px) { .quiet { display: flex; } }
</style>
