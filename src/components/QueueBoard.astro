---
/* The queue board: the one dark screen in the light room. Sample data, labelled. The numbers step forward
   every few seconds so the object reads as live; under reduced motion it holds still. */
import { t, type Locale } from '../i18n';
interface Props { locale: Locale; class?: string }
const { locale, class: cls = '' } = Astro.props;
const rows = [
  { room: t(locale, 'board.room1'), now: 9, wait: 6 },
  { room: t(locale, 'board.room2'), now: 27, wait: 11 },
  { room: t(locale, 'board.room3'), now: 14, wait: 4 },
];
---
<figure class:list={['qb-wrap', cls]}>
  <div class="qb" id="queue-board" role="img" aria-label={t(locale, 'board.alt')}>
    <div class="qb-head">
      <span class="qb-title">{t(locale, 'board.title')}</span>
      <span class="qb-clock num" data-clock>10:42</span>
    </div>
    <ul class="qb-rows">
      {rows.map((r) => (
        <li class="qb-row">
          <span class="qb-room">{r.room}</span>
          <span class="qb-cell"><span class="qb-label">{t(locale, 'board.now')}</span><span class="qb-now num" data-now={r.now}>{r.now}</span></span>
          <span class="qb-cell"><span class="qb-label">{t(locale, 'board.waiting')}</span><span class="qb-wait num" data-wait={r.wait}>{r.wait}</span></span>
        </li>
      ))}
    </ul>
    <div class="qb-foot">
      <span class="qb-label">{t(locale, 'board.next')}</span>
      <span class="qb-next num" data-next>10, 11, 12</span>
    </div>
  </div>
  <figcaption class="sample">{t(locale, 'board.sample')}</figcaption>
</figure>
<style>
  .qb-wrap { display: grid; gap: 8px; justify-items: start; width: 100%; }
  .qb { width: 100%; background: var(--ink-950); color: var(--aqua-200); border: 1px solid var(--ink-800); border-radius: 12px; padding: 18px 18px 16px; display: grid; gap: 14px; font-variant-numeric: tabular-nums;
    box-shadow: inset 0 0 0 1px rgba(64, 232, 224, 0.08), inset 0 24px 60px rgba(64, 232, 224, 0.06); }
  .qb-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding-bottom: 12px; border-bottom: 1px solid var(--ink-800); }
  .qb-title { font-weight: 700; font-size: 15px; color: #F2FBFA; }
  .qb-clock { color: var(--mist-on-ink); font-size: 15px; }
  .qb-rows { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .qb-row { display: grid; grid-template-columns: 1fr auto auto; gap: 14px 18px; align-items: end; padding-bottom: 10px; border-bottom: 1px solid var(--ink-800); }
  .qb-row:last-child { border-bottom: 0; padding-bottom: 0; }
  .qb-room { font-weight: 600; font-size: 15px; color: #F2FBFA; line-height: 1.3; align-self: center; }
  .qb-cell { display: grid; gap: 2px; justify-items: end; min-width: 64px; }
  .qb-label { color: var(--mist-on-ink); font-size: 12px; font-weight: 600; letter-spacing: 0; }
  .qb-now { font-size: clamp(34px, 4vw, 44px); font-weight: 800; color: var(--aqua-400); line-height: 1; display: inline-block; }
  .qb-wait { font-size: 22px; font-weight: 700; color: var(--aqua-200); line-height: 1.1; display: inline-block; }
  .qb-foot { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding-top: 2px; }
  .qb-next { color: var(--aqua-200); font-size: 15px; }
  /* the step: a number leaves upward and the next arrives from below, one authored motion on the object */
  .qb-now.tick, .qb-wait.tick { animation: qb-step .42s cubic-bezier(.16, 1, .3, 1); }
  @keyframes qb-step { 0% { transform: translateY(70%); opacity: 0; } 100% { transform: none; opacity: 1; } }
  @media (min-width: 768px) {
    .qb { padding: 22px 22px 18px; gap: 16px; }
    .qb-row { gap: 14px 26px; }
    .qb-cell { min-width: 76px; }
  }
  @media (prefers-reduced-motion: reduce) { .qb-now.tick, .qb-wait.tick { animation: none; } }
</style>
<script>
  /* Advance one room every few seconds. Real boards jump; this one steps, which is enough to read as alive. */
  const board = document.getElementById('queue-board');
  if (board && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const rows = Array.from(board.querySelectorAll<HTMLElement>('.qb-row'));
    const clock = board.querySelector<HTMLElement>('[data-clock]');
    const next = board.querySelector<HTMLElement>('[data-next]');
    let minutes = 10 * 60 + 42;
    let i = 0;
    const bump = (el: HTMLElement | null, delta: number, floor = 0) => {
      if (!el) return;
      const v = Math.max(floor, Number(el.textContent) + delta);
      el.classList.remove('tick'); void el.offsetWidth;
      el.textContent = String(v); el.classList.add('tick');
    };
    let visible = true;
    if ('IntersectionObserver' in window) new IntersectionObserver((e) => { visible = e.some((x) => x.isIntersecting); }, { threshold: 0.2 }).observe(board);
    window.setInterval(() => {
      if (!visible || document.hidden) return;
      const row = rows[i % rows.length]; i++;
      const now = row.querySelector<HTMLElement>('.qb-now');
      const wait = row.querySelector<HTMLElement>('.qb-wait');
      bump(now, 1); bump(wait, -1, 0);
      if (i % 3 === 0 && wait && Number(wait.textContent) < 3) bump(wait, 3);
      if (i % 2 === 0) { minutes++; if (clock) clock.textContent = `${String(Math.floor(minutes / 60) % 24).padStart(2, '0')}:${String(minutes % 60).padStart(2, '0')}`; }
      if (next && now && row === rows[0]) { const n = Number(now.textContent); next.textContent = `${n + 1}, ${n + 2}, ${n + 3}`; }
    }, 3600);
  }
</script>
