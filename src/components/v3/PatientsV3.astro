---
import Icon from '../Icon.astro';
import { t, localePath, type Locale } from '../../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
/* v3 patients: a family, and the four steps a patient actually takes. The steps are the same copy as the patient page. */
---
<section id="patients" class="section">
  <div class="container grid">
    <figure class="ph"><img src="/photos/father-baby.webp" width="1000" height="667" alt={t(locale, 'v3.pat.alt')} loading="lazy" decoding="async" /></figure>
    <div class="copy">
      <h2>{t(locale, 'v3.pat.h2')}</h2>
      <ol class="steps">
        {[1, 2, 3, 4].map((i) => <li><span class="n num">{i}</span><span>{t(locale, `how.step.${i}`)}</span></li>)}
      </ol>
      <a class="btn btn-secondary" href={localePath(locale, '/patients/how-it-works')} data-track="find_doctor_click" data-audience="patient">{t(locale, 'patients.cta')} <Icon name="arrow-right" size={18} /></a>
    </div>
  </div>
</section>
<style>
  .grid { display: grid; gap: 32px; align-items: center; }
  .ph { margin: 0; border-radius: 28px; overflow: hidden; aspect-ratio: 4 / 3; background: var(--bg-alt); }
  .ph img { width: 100%; height: 100%; object-fit: cover; display: block; }
  h2 { font-size: clamp(28px, 3.2vw, 40px); letter-spacing: -0.03em; line-height: 1.12; max-width: 18ch; }
  .steps { list-style: none; margin: 24px 0 28px; padding: 0; display: grid; gap: 14px; }
  .steps li { display: grid; grid-template-columns: 40px 1fr; gap: 14px; align-items: center; font-weight: 600; font-size: 17px; }
  .n { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; background: #E6EDFA; color: var(--orbit-700); font-weight: 800; }
  :global(html[data-theme="dark"]) .n { background: #1A2A4A; color: var(--orbit-300); }
  @media (min-width: 900px) { .grid { grid-template-columns: 1fr 1fr; gap: 64px; } }
</style>
