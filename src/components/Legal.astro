---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { t, type Locale } from '../i18n';
import type { LegalDoc } from '../content/legal';
interface Props { locale: Locale; doc: LegalDoc }
const { locale, doc } = Astro.props;
const title = locale === 'bn' ? doc.titleBn : doc.title;
/* [bracketed text] is a placeholder for the legal team; it is highlighted so nobody ships it by accident. */
const mark = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/\[([^\]]+)\]/g, '<mark class="ph">[$1]</mark>');
---
<Base title={`${title}, LofiCare`} description={locale === 'bn' ? doc.introBn : doc.intro} locale={locale} path={`/${doc.slug}`}>
  <Header locale={locale} />
  <main id="main" class="section">
    <div class="container legal">
      <p class="draft" role="note">{t(locale, 'legal.draft')}</p>
      <h1>{title}</h1>
      <p class="updated muted">{t(locale, 'legal.updated')}: <span class="num">{doc.updated}</span></p>
      <p class="lede" set:html={mark(locale === 'bn' ? doc.introBn : doc.intro)} />
      <nav class="toc" aria-label={t(locale, 'legal.contents')}>
        <p class="toc-h">{t(locale, 'legal.contents')}</p>
        <ol>{doc.sections.map((s) => <li><a href={`#${s.id}`}>{locale === 'bn' ? s.hBn : s.h}</a></li>)}</ol>
      </nav>
      <div class="body">
        {doc.sections.map((s) => (
          <section id={s.id} class="sec">
            <h2>{locale === 'bn' ? s.hBn : s.h}</h2>
            {locale === 'bn' ? (
              <>
                <p class="summary" lang="bn" set:html={mark(s.summaryBn)} />
                <details class="en">
                  <summary>{t(locale, 'legal.english')}</summary>
                  <div lang="en">{s.body.map((p) => <p set:html={mark(p)} />)}</div>
                </details>
              </>
            ) : (
              s.body.map((p) => <p set:html={mark(p)} />)
            )}
          </section>
        ))}
      </div>
    </div>
  </main>
  <Footer locale={locale} />
</Base>
<style>
  .legal { max-width: 760px; }
  .draft { display: inline-block; border: 1.5px solid var(--cta); border-radius: var(--radius-control); padding: 8px 12px; font-weight: 700; font-size: 14px; margin-bottom: 16px; }
  h1 { font-size: clamp(28px, 4vw, 40px); }
  .updated { margin: 8px 0 14px; font-size: 14px; }
  .toc { margin: 24px 0 8px; padding: 16px 18px; background: var(--bg-alt); border: 1px solid var(--line); border-radius: var(--radius-tile); }
  .toc-h { font-weight: 700; margin-bottom: 6px; }
  .toc ol { margin: 0; padding-left: 20px; columns: 2; column-gap: 24px; }
  .toc li { break-inside: avoid; padding: 2px 0; }
  .toc a { color: var(--accent); text-decoration: none; }
  .toc a:hover { text-decoration: underline; }
  .sec { padding: 22px 0; border-top: 1px solid var(--line); }
  .sec h2 { font-size: 20px; margin-bottom: 10px; }
  .sec p { margin-bottom: 10px; max-width: 70ch; }
  .summary { font-weight: 600; }
  .en { margin-top: 6px; }
  .en summary { cursor: pointer; color: var(--accent); font-weight: 700; font-size: 14px; }
  .en div { margin-top: 10px; }
  :global(mark.ph) { background: var(--wash-100); color: var(--ink-950); border: 1px dashed var(--accent-strong); border-radius: 4px; padding: 0 4px; }
  :global(html[data-theme="dark"] mark.ph) { background: var(--ink-800); color: var(--aqua-200); }
  @media (max-width: 640px) { .toc ol { columns: 1; } }
</style>
