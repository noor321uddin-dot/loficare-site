---
import { t, type Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
/* one line, in the page's own language */
---
<section id="trust" class="trust section-alt" aria-label={t(locale, 'a11y.trust')}>
  <div class="container">
    <p class="line">{t(locale, 'trust.line')}</p>
  </div>
</section>
<style>
  .trust { padding-block: 28px; text-align: center; }
  .line { font-weight: 700; font-size: clamp(18px, 2.2vw, 24px); line-height: 1.45; margin: 0; }
  @media (min-width: 768px) { .trust { padding-block: 36px; } }
</style>
