---
import Icon from './Icon.astro';
import Mark from './Mark.astro';
import { t, type Locale } from '../i18n';
interface Props { locale: Locale; class?: string }
const { locale, class: cls = '' } = Astro.props;
/* The hero's one object: a doctor and the LofiCare mark at the centre, the platform's eight areas in a slow
   orbit around them. Pick an area and the orbit turns it to the top and opens its modules; the areas it hands
   work to pulse. Same engine as the hospital orbit, vanilla, no framework. Only the appointment module is
   marked live; everything else says early access. The portrait is stock, labelled as a sample. */
type Area = { key: string; icon: string; mods: string[]; live?: string; rel: number[] };
const areas: Area[] = [
  { key: 'core', icon: 'calendar-check', live: 'Appointment, queue and front desk', mods: ['Patient identity and registry', 'Billing, payments and counter', 'Doctor, referrer and earnings'], rel: [2, 3, 7] },
  { key: 'diagnostics', icon: 'flask', mods: ['Sample, collection, barcode and QR', 'Result entry and quality control', 'Report release and delivery'], rel: [1, 3] },
  { key: 'clinical', icon: 'stethoscope', mods: ['Clinical records, prescription and digital forms'], rel: [1, 4] },
  { key: 'hospital', icon: 'bed', mods: ['Admission, ward, OT, emergency and ancillary'], rel: [3, 5] },
  { key: 'supply', icon: 'pill', mods: ['Pharmacy and inventory'], rel: [4, 8] },
  { key: 'operations', icon: 'users-three', mods: ['Workforce, assets and compliance'], rel: [1, 8] },
  { key: 'engagement', icon: 'chat-circle-dots', mods: ['Communication, patient portal and service desk'], rel: [1, 3] },
  { key: 'insight', icon: 'chart-line-up', mods: ['Reporting, analytics and MIS'], rel: [1, 6] },
];
const nodes = areas.map((a, i) => ({ ...a, id: i + 1, name: t(locale, `platform.tier.${a.key}`) }));
const early = t(locale, 'platform.early');
const liveStatus = t(locale, 'platform.live.status');
---
<figure class:list={['ho-wrap', cls]} id="hero-orbit">
  <div class="ho">
    <svg class="ho-track" viewBox="0 0 400 400" aria-hidden="true">
      <circle cx="200" cy="200" r="150" />
      <circle class="inner" cx="200" cy="200" r="96" />
    </svg>
    <div class="core" aria-hidden="true">
      <span class="ping"></span><span class="ping p2"></span>
      <span class="portrait"><img src="/voices/sample-2.webp" alt="" width="240" height="240" fetchpriority="high" decoding="async" /></span>
      <span class="badge"><Mark size={30} /></span>
    </div>
    {nodes.map((n, i) => (
      <button type="button" class:list={['nd', n.live && 'is-live']} style={`--i:${i}`} data-id={n.id} data-rel={n.rel.join(',')} aria-expanded="false" aria-controls={`ho-card-${n.id}`}>
        <span class="dot"><Icon name={n.icon} size={18} /></span>
        <span class="lbl">{n.name}</span>
      </button>
    ))}
    {nodes.map((n) => (
      <div class="ho-card" id={`ho-card-${n.id}`} hidden>
        <button type="button" class="x" aria-label={t(locale, 'hospitals.close')}><Icon name="x" size={16} /></button>
        <h3>{n.name}</h3>
        <ul>
          {n.live && <li class="live"><span>{n.live}</span><em>{liveStatus}</em></li>}
          {n.mods.map((m) => <li><span>{m}</span><em>{early}</em></li>)}
        </ul>
        <p class="rel-l">{t(locale, 'hospitals.related')}</p>
        <div class="rel">{n.rel.map((id) => <button type="button" class="chip" data-go={id}>{nodes[id - 1].name}</button>)}</div>
      </div>
    ))}
  </div>
  <figcaption class="sample">{t(locale, 'hero.orbit.caption')}</figcaption>
</figure>
<style>
  .ho-wrap { margin: 0; display: grid; gap: 12px; justify-items: center; width: 100%; }
  .ho { position: relative; width: min(100%, 340px); aspect-ratio: 1; --r: 126px; }
  .ho-track { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .ho-track circle { fill: none; stroke: var(--tile-line); stroke-width: 1.2; opacity: .45; }
  .ho-track .inner { stroke-dasharray: 3 7; opacity: .35; }
  /* centre: the doctor, the mark pinned to the portrait */
  .core { position: absolute; left: 50%; top: 50%; width: 132px; height: 132px; transform: translate(-50%, -50%); z-index: 50; }
  .portrait { position: absolute; inset: 0; border-radius: 50%; overflow: hidden; background: var(--wash-100); box-shadow: 0 0 0 5px var(--bg), 0 0 0 6.5px var(--aqua-400); animation: breathe 5s ease-in-out infinite; }
  .portrait img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 20%; display: block; }
  .badge { position: absolute; right: -6px; bottom: -2px; width: 46px; height: 46px; border-radius: 50%; background: var(--ink-950); display: grid; place-items: center; box-shadow: 0 0 0 4px var(--bg); }
  .ping { position: absolute; inset: -10px; border-radius: 50%; border: 1px solid var(--aqua-400); opacity: 0; animation: ping 3.2s cubic-bezier(0, 0, .2, 1) infinite; }
  .p2 { animation-delay: 1.6s; }
  @keyframes ping { 0% { transform: scale(1); opacity: .5; } 75%, 100% { transform: scale(1.5); opacity: 0; } }
  @keyframes breathe { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.025); } }
  /* nodes */
  .nd { position: absolute; left: 50%; top: 50%; display: grid; justify-items: center; gap: 5px; border: 0; background: none; padding: 0; cursor: pointer; font: inherit; color: var(--fg); will-change: transform; transform: translate(calc(-50% + var(--x, 0px)), calc(-50% + var(--y, 0px))); }
  .nd:focus-visible { outline: none; }
  .nd:focus-visible .dot { outline: 3px solid var(--aqua-400); outline-offset: 2px; }
  .dot { width: 42px; height: 42px; border-radius: 50%; display: grid; place-items: center; background: var(--card); border: 1.5px solid var(--line); color: var(--accent); transition: background-color .25s, border-color .25s, transform .25s, color .25s, opacity .6s; }
  .lbl { font-size: 12px; font-weight: 700; white-space: nowrap; transition: opacity .6s; }
  .nd.is-live .dot { background: linear-gradient(135deg, #40E8E0, #A7FCF6); border-color: transparent; color: var(--ink-950); }
  .nd:hover .dot { border-color: var(--accent-strong); }
  .nd.active .dot { background: var(--ink-950); color: var(--aqua-200); border-color: var(--aqua-400); transform: scale(1.18); }
  .nd.related .dot { border-color: var(--accent-strong); animation: npulse 1.4s ease-in-out infinite; }
  @keyframes npulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(64, 232, 224, .45); } 50% { box-shadow: 0 0 0 7px rgba(64, 232, 224, 0); } }
  :global(html[data-theme="dark"]) .nd.active .dot { background: var(--aqua-400); color: var(--ink-950); }
  .ho:not(.in) .dot, .ho:not(.in) .lbl { opacity: 0; }
  .ho.in .dot, .ho.in .lbl { transition-delay: calc(var(--i) * 70ms); }
  /* card, opened under the node brought to the top */
  .ho-card { position: absolute; left: 50%; top: calc(50% - var(--r) + 44px); width: min(290px, 92vw); z-index: 300; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius-tile); padding: 16px 16px 18px; display: grid; gap: 8px; text-align: left; transform: translate(-50%, 8px); opacity: 0; transition: opacity .25s, transform .25s; box-shadow: 0 18px 44px -14px rgba(4, 26, 26, .35); }
  .ho-card[hidden] { display: none; }
  .ho-card.show { opacity: 1; transform: translate(-50%, 0); }
  .ho-card h3 { margin: 0; font-size: 18px; letter-spacing: -.01em; padding-right: 32px; }
  .ho-card ul { list-style: none; margin: 0; padding: 0; display: grid; }
  .ho-card li { display: grid; gap: 1px; padding: 7px 0; border-top: 1px solid var(--line); font-size: 14px; font-weight: 600; line-height: 1.35; }
  .ho-card li em { font-style: normal; font-size: 12px; font-weight: 600; color: var(--fg-muted); }
  .ho-card li.live em { color: var(--ok); }
  .x { position: absolute; top: 8px; right: 8px; width: 36px; height: 36px; border: 0; background: none; border-radius: 50%; display: grid; place-items: center; color: var(--fg-muted); cursor: pointer; }
  .x:hover { background: var(--bg-alt); color: var(--fg); }
  .rel-l { margin: 4px 0 0; font-size: 12px; font-weight: 700; color: var(--fg-muted); }
  .rel { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip { border: 1px solid var(--line); border-radius: 999px; padding: 6px 10px; font: inherit; font-size: 13px; font-weight: 600; background: var(--bg); color: var(--fg); cursor: pointer; }
  .chip:hover { border-color: var(--accent-strong); }
  .sample { justify-self: center; }
  @media (min-width: 768px) {
    .ho { width: 460px; --r: 172px; }
    .core { width: 168px; height: 168px; }
    .badge { width: 54px; height: 54px; }
    .lbl { font-size: 13px; }
  }
  @media (min-width: 1100px) { .ho { width: 500px; --r: 188px; } .core { width: 180px; height: 180px; } }
  @media (prefers-reduced-motion: reduce) {
    .ping, .portrait, .nd.related .dot { animation: none; }
    .dot, .lbl, .ho-card { transition: none; }
  }
</style>
<script>
  const root = document.getElementById('hero-orbit');
  const ho = root?.querySelector<HTMLElement>('.ho');
  if (root && ho) {
    const nodes = Array.from(ho.querySelectorAll<HTMLButtonElement>('.nd'));
    const cards = Array.from(ho.querySelectorAll<HTMLElement>('.ho-card'));
    const N = nodes.length;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let angle = -90, goal: number | null = null, auto = !reduced;
    let active: HTMLButtonElement | null = null, raf = 0, last = 0, running = false, visible = false;
    const radius = () => parseFloat(getComputedStyle(ho).getPropertyValue('--r')) || 170;
    const layout = () => {
      const r = radius();
      nodes.forEach((n, i) => {
        const a = (((i / N) * 360 + angle) * Math.PI) / 180, s = Math.sin(a);
        n.style.setProperty('--x', `${(Math.cos(a) * r).toFixed(1)}px`);
        n.style.setProperty('--y', `${(s * r).toFixed(1)}px`);
        n.style.zIndex = String(Math.round(100 - 50 * s));
        n.style.opacity = (active ? (n === active || n.classList.contains('related') ? 1 : 0.4) : 0.72 + 0.28 * ((1 - s) / 2)).toFixed(2);
      });
    };
    const tick = (ts: number) => {
      const dt = last ? Math.min(ts - last, 64) : 16; last = ts;
      if (goal !== null) { const d = ((goal - angle + 540) % 360) - 180; if (Math.abs(d) < 0.15) { angle = goal; goal = null; } else angle += d * Math.min(1, dt / 240); }
      else if (auto) angle = (angle + dt * 0.006) % 360;
      layout();
      if (running && (auto || goal !== null)) raf = requestAnimationFrame(tick); else running = false;
    };
    const run = () => { if (!running && visible) { running = true; last = 0; raf = requestAnimationFrame(tick); } };
    const halt = () => { running = false; cancelAnimationFrame(raf); };
    const cardFor = (n: HTMLButtonElement) => cards[nodes.indexOf(n)];
    const open = (n: HTMLButtonElement) => {
      if (active) cardFor(active).classList.remove('show'), (cardFor(active).hidden = true);
      active = n; auto = false;
      const rel = (n.dataset.rel || '').split(',');
      nodes.forEach((m) => { m.setAttribute('aria-expanded', String(m === n)); m.classList.toggle('active', m === n); m.classList.toggle('related', m !== n && rel.includes(m.dataset.id || '')); });
      const top = (((270 - (nodes.indexOf(n) / N) * 360) % 360) + 360) % 360;
      if (reduced) { angle = top; layout(); } else { goal = top; run(); }
      const c = cardFor(n); c.hidden = false; requestAnimationFrame(() => c.classList.add('show'));
    };
    const close = (refocus = false) => {
      if (!active) return;
      const was = active, c = cardFor(was);
      active = null; goal = null;
      nodes.forEach((m) => { m.setAttribute('aria-expanded', 'false'); m.classList.remove('active', 'related'); });
      c.classList.remove('show'); c.hidden = true;
      auto = !reduced; layout(); run();
      if (refocus) was.focus();
    };
    nodes.forEach((n) => n.addEventListener('click', (e) => { e.stopPropagation(); active === n ? close() : open(n); }));
    cards.forEach((c) => {
      c.addEventListener('click', (e) => e.stopPropagation());
      c.querySelector('.x')!.addEventListener('click', () => close(true));
      c.querySelectorAll<HTMLButtonElement>('.chip').forEach((b) => b.addEventListener('click', () => { const t = nodes[Number(b.dataset.go) - 1]; if (t) open(t); }));
    });
    ho.addEventListener('click', () => close());
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && active) close(true); });
    document.addEventListener('visibilitychange', () => (document.hidden ? halt() : run()));
    addEventListener('resize', layout);
    layout();
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((es) => { visible = es.some((e) => e.isIntersecting); if (visible) { ho.classList.add('in'); run(); } else halt(); }).observe(ho);
    } else { visible = true; ho.classList.add('in'); run(); }
  }
</script>
