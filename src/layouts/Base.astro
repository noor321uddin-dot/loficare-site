---
import '../styles/global.css';
import '@fontsource-variable/manrope';
import '../styles/fonts.css';
import Consent from '../components/Consent.astro';
import type { Locale } from '../i18n';
const manropeUrl = '/fonts/manrope-basic-v1.woff2';
/* Anek Bangla ships as two static weights built by scripts/subset-fonts.py (51 KB each instead of the 156 KB
   variable file). On the Bangla route the headline needs the 700 face, so both faces are declared inline and the
   700 file is preloaded. On the English route only the trust line and the patient thread use Bangla, so the faces
   are added after the page has loaded (Font Loading API) and never compete with the headline's first paint.
   Latin characters inside Bangla runs fall through to Manrope (see --font-bangla in tokens.css). */
const BENGALI_RANGE = 'U+0980-09FF, U+1CD0-1CFA, U+200C-200D, U+20B9, U+25CC';
const anek700 = '/fonts/anek-bangla-700-v1.woff2';
const anek400 = '/fonts/anek-bangla-400-v1.woff2';
const face = (url: string, weight: number) => `@font-face{font-family:'Anek Bangla Variable';font-style:normal;font-display:swap;font-weight:${weight};src:url(${url}) format('woff2');unicode-range:${BENGALI_RANGE}}`;
const anekFaces = face(anek700, 700) + face(anek400, 400);
const anekLazy = `window.addEventListener('load',function(){setTimeout(function(){if(!('FontFace' in window))return;[['${anek700}','700'],['${anek400}','400']].forEach(function(f){var face=new FontFace('Anek Bangla Variable','url('+f[0]+') format("woff2")',{weight:f[1],display:'swap',unicodeRange:'${BENGALI_RANGE}'});face.load().then(function(){document.fonts.add(face)}).catch(function(){})})},600)});`;
interface Props { title: string; description?: string; locale?: Locale; path?: string; jsonLd?: Record<string, unknown>[]; noindex?: boolean }
const { title, description = '', locale = 'en', path = '/', jsonLd = [], noindex = false } = Astro.props;
const site = ((import.meta.env.SITE_URL as string | undefined) || 'http://127.0.0.1:4321').replace(/\/$/, '');
const enUrl = site + path;
const bnUrl = site + '/bn' + path;
const canonical = locale === 'en' ? enUrl : bnUrl;
const ogImage = site + '/og/loficare-og.png';
const analyticsDomain = (import.meta.env.ANALYTICS_DOMAIN as string | undefined) || '';
const ld: Record<string, unknown>[] = [
  { '@context': 'https://schema.org', '@type': 'Organization', name: 'LofiCare', url: site + '/', logo: site + '/brand/icon-192.png', areaServed: 'BD' },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'LofiCare', url: site + '/', inLanguage: locale === 'bn' ? 'bn-BD' : 'en' },
  ...jsonLd,
];
---
<!doctype html>
<html lang={locale} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#F6FAFA" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="preload" as="font" type="font/woff2" href={manropeUrl} crossorigin />
    {locale === 'bn' && <link rel="preload" as="font" type="font/woff2" href={anek700} crossorigin />}
    {locale === 'bn' ? <style set:html={anekFaces} /> : <script is:inline set:html={anekLazy} />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="bn" href={bnUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LofiCare" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="LofiCare mark and wordmark on dark teal, the hospital and diagnostic centre platform built for Bangladesh" />
    <meta property="og:locale" content={locale === 'bn' ? 'bn_BD' : 'en_GB'} />
    <meta property="og:locale:alternate" content={locale === 'bn' ? 'en_GB' : 'bn_BD'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/brand/loficare-mark.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/brand/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {ld.map((o) => <script is:inline type="application/ld+json" set:html={JSON.stringify(o)} />)}
    <script is:inline>
      (function () {
        var d = document.documentElement;
        try {
          /* light by default (user decision); dark only when the visitor chose it */
          var s = localStorage.getItem('lc-theme');
          d.setAttribute('data-theme', s === 'dark' ? 'dark' : 'light');
          if (s === 'dark') { var m = document.querySelector('meta[name="theme-color"]'); if (m) m.setAttribute('content', '#041A1A'); }
        } catch (e) { d.setAttribute('data-theme', 'light'); }
      })();
    </script>
  </head>
  <body>
    <!--
      DIRECTION CONTRACT, seed 17f59650
      THESIS: The complete facility platform you can start today, shown as disconnected modules becoming one mark.
      WORLD: The queue board. A light room with one dark screen in it; numbers as facts, tabular and a weight heavier; motion steps, overshoots and settles, never fades.
      FIRST VIEWPORT: Left, the facility claim and two actions. Right, the waiting-room queue board itself, the one dark screen in the light room, its serials stepping forward on sample data.
      VISITOR PATH: hero, three doors, trust line, problem, the 18 modules, diagnostics, hospitals, the live module, doctors, patients, data, cohorts, pricing, FAQ, demo, footer.
      SIGNATURE: The board's numbers step; in the platform section eighteen named tiles assemble into the mark on scroll; departments leave the record and take their places on the hospital ring. Static under reduced motion. Light by default, dark by choice.
      RISK: Aqua on paper is a large-shape colour only; every text pair passes AA through the tokens.
    -->
    <slot />
    <Consent locale={locale} analyticsDomain={analyticsDomain} />
  </body>
</html>
